<?xml version="1.0"?>
<robot name="burger_simplified">
  <link name="base_footprint"/>
  <link name="base_link">
    <inertial><mass value="0.85"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.003"/></inertial>
    <visual><geometry><box size="0.138 0.138 0.05"/></geometry><material name="black"><color rgba="0.12 0.12 0.12 1"/></material></visual>
    <collision><geometry><box size="0.138 0.138 0.05"/></geometry></collision>
  </link>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.06"/></joint>
  <link name="left_wheel">
    <inertial><mass value="0.05"/><inertia ixx="0.000015" ixy="0" ixz="0" iyy="0.000027" iyz="0" izz="0.000015"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.033" length="0.018"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.033" length="0.018"/></geometry></collision>
  </link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.08 -0.027"/><axis xyz="0 1 0"/><limit effort="5" velocity="12"/><dynamics damping="0.01"/></joint>
  <link name="right_wheel">
    <inertial><mass value="0.05"/><inertia ixx="0.000015" ixy="0" ixz="0" iyy="0.000027" iyz="0" izz="0.000015"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.033" length="0.018"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.033" length="0.018"/></geometry></collision>
  </link>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.08 -0.027"/><axis xyz="0 1 0"/><limit effort="5" velocity="12"/><dynamics damping="0.01"/></joint>
  <link name="caster">
    <inertial><mass value="0.01"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial>
    <visual><geometry><sphere radius="0.01"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.01"/></geometry></collision>
  </link>
  <joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster"/><origin xyz="-0.055 0 -0.05"/></joint>
  <link name="base_scan">
    <inertial><mass value="0.06"/><inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/></inertial>
    <visual><geometry><cylinder radius="0.035" length="0.035"/></geometry><material name="green"><color rgba="0.15 0.65 0.25 1"/></material></visual>
    <collision><geometry><cylinder radius="0.035" length="0.035"/></geometry></collision>
  </link>
  <joint name="scan_joint" type="fixed"><parent link="base_link"/><child link="base_scan"/><origin xyz="0 0 0.12"/></joint>
  <gazebo reference="left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="caster"><mu1>0.001</mu1><mu2>0.001</mu2></gazebo>
  <gazebo reference="base_scan">
    <sensor name="laser" type="ray">
      <always_on>true</always_on><update_rate>10</update_rate><visualize>true</visualize>
      <ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>6.26573201466</max_angle></horizontal></scan><range><min>0.12</min><max>3.5</max><resolution>0.01</resolution></range></ray>
      <plugin name="laser_ros" filename="libgazebo_ros_ray_sensor.so"><ros><remapping>~/out:=scan</remapping></ros><output_type>sensor_msgs/LaserScan</output_type><frame_name>base_scan</frame_name></plugin>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin name="differential_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>cmd_vel:=cmd_vel</remapping><remapping>odom:=odom</remapping></ros>
      <update_rate>50</update_rate><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.16</wheel_separation><wheel_diameter>0.066</wheel_diameter>
      <max_wheel_torque>5</max_wheel_torque><max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame><robot_base_frame>base_footprint</robot_base_frame><odometry_source>1</odometry_source>
    </plugin>
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so"><update_rate>30</update_rate><joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name></plugin>
  </gazebo>
</robot>
